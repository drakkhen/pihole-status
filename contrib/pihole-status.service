[Unit]
Description=Pi-hole statistics on the OLED display
Wants=network-online.target
After=network-online.target pihole-FTL.service

[Service]
ExecStart=/opt/pihole-status/bin/pihole-status --control 0.0.0.0:5001
# For a remote Pi-hole: PIHOLE_URL and PIHOLE_PASSWORD. Root-only.
EnvironmentFile=-/etc/pihole-status.env
DynamicUser=yes
# The pihole group can read FTL's local CLI password.
Environment=PIHOLE_PASSWORD_FILE=/etc/pihole/cli_pw
SupplementaryGroups=i2c pihole
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
